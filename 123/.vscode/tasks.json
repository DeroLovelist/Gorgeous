{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "EIDE: 重载 + 构建",
            "detail": "通过 EIDE MCP 自动重载工程配置并构建（移植/改 eide.yml 后用它，无需手动点 reload）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/tools/eide-mcp.ps1",
                "-Action", "all"
            ],
            "problemMatcher": [],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "EIDE: 重载 + 全量重建",
            "detail": "重载工程并执行 Rebuild（全部重新编译）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/tools/eide-mcp.ps1",
                "-Action", "rebuild"
            ],
            "problemMatcher": [],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "EIDE: 重载 + 烧录",
            "detail": "重载工程并通过 ST-Link 烧录到板子",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/tools/eide-mcp.ps1",
                "-Action", "flash"
            ],
            "problemMatcher": [],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "编码: 检查/补 UTF-8 BOM",
            "detail": "Keil(AC5) 按本地编码解析源文件；含中文的源文件必须是 GBK 或 UTF-8+BOM。此任务给「UTF-8 无 BOM」的文件补 BOM（VS Code 编辑后跑一次，再让 Keil 全编译）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/tools/fix-src-encoding.ps1"
            ],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        }
    ]
}
